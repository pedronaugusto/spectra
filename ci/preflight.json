{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**",
    "src/**/*_test.zig"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "shipped": {
    "LICENSES": "the MIT and BSD licences of the Rust regex code src/hir translates and of the RE2 and test262 material the tests carry: those licences ask that they travel with copies of the code"
  },
  "function_exceptions": {},
  "layout_exceptions": {},
  "glint_paths": [
    "src",
    "build.zig",
    "bench"
  ],
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "spectra"
      ]
    },
    "zig build docs -- ecmascript": {
      "source": "examples/usage.zig",
      "region": "ecmascript",
      "imports": [
        "spectra"
      ]
    },
    "zig build docs -- refusal": {
      "source": "examples/usage.zig",
      "region": "refusal",
      "imports": [
        "spectra"
      ]
    }
  }
}
