{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/**",
    "src/**/*_test.zig"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "function_exceptions": {},
  "layout_exceptions": {
    "src/kernels": {
      "files": [
        "src/kernels/teddy.zig",
        "src/kernels/x86_ssse3.zig",
        "src/kernels/x86_avx2.zig",
        "src/kernels/arm_neon.zig"
      ],
      "reason": "Each file is the root of a module of its own, the kernels built with the CPU features their instructions need (Zig sets features per module) and the scan they share; they share no namespace and are imported by module name, so an entry file would publish nothing."
    }
  },
  "glint_paths": [
    "src",
    "build.zig",
    "bench"
  ],
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "spectra"
      ]
    },
    "zig build docs -- ecmascript": {
      "source": "examples/usage.zig",
      "region": "ecmascript",
      "imports": [
        "spectra"
      ]
    },
    "zig build docs -- refusal": {
      "source": "examples/usage.zig",
      "region": "refusal",
      "imports": [
        "spectra"
      ]
    }
  }
}
